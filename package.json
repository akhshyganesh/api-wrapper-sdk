{
  "name": "api-wrapper-sdk",
  "version": "1.0.0",
  "description": "Type-safe, configuration-driven API wrapper with excellent maintainability",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "jest",
    "demo": "node examples/demo.js",
    "usage": "npx ts-node --transpile-only examples/usage.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepublishOnly": "npm run clean && npm run build",
    "server:install": "cd server && npm install",
    "server:start": "cd server && npm start",
    "server:dev": "cd server && npm run dev",
    "server:test": "cd server && node test.js"
  },
  "keywords": [
    "api",
    "wrapper",
    "typescript",
    "http-client",
    "rest-api"
  ],
  "author": "akhshyganesh <akhshy.balakannan@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^4.0.0"
  },
  "dependencies": {
    "axios": "^1.6.0"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/akhshyganesh/api-wrapper-sdk.git"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
